{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marine-tools-api",
  "main": "worker/worker-v855.js",
  "compatibility_date": "2026-10-03",
  "workers_dev": false,
  "preview_urls": false,
  "previews": {},
  "keep_vars": true,
  "routes": [
    {
      "pattern": "api.marinetools.app",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": true
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "marine_tools_usage"
    }
  ],
  "analytics": {
    "binding": "ANALYTICS_SQL"
  }
}
